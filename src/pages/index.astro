---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";

const features = [
  {
    title: "File-based pages",
    body: "Drop a file in src/pages and it becomes a route. No router config to maintain.",
  },
  {
    title: "CSS-first tokens",
    body: "Colors, fonts, and dark mode live in global.css. Change a variable, restyle the site.",
  },
  {
    title: "One layout",
    body: "SEO tags, skip link, header, and footer ship from Layout.astro so every page stays consistent.",
  },
];

const steps = [
  {
    n: "01",
    title: "Rename the site",
    body: "Update title, description, and nav labels in src/consts.ts.",
  },
  {
    n: "02",
    title: "Recolor the tokens",
    body: "Edit the :root and .dark variables in src/styles/global.css.",
  },
  {
    n: "03",
    title: "Replace this page",
    body: "Rewrite src/pages/index.astro, then add more routes beside it.",
  },
];
---

<Layout>
  <section class="border-line border-b">
    <div
      class="mx-auto grid max-w-6xl gap-12 px-6 py-20 lg:grid-cols-[1.2fr_0.8fr] lg:items-end lg:py-28"
    >
      <div>
        <p
          class="text-copper mb-6 text-xs font-semibold tracking-[0.22em] uppercase"
        >
          Astro 7 · Tailwind CSS v4
        </p>
        <h1
          class="font-display max-w-xl text-5xl leading-[1.05] font-semibold tracking-tight sm:text-6xl"
        >
          A quiet starter for sites that need to ship.
        </h1>
        <p class="text-ink-muted mt-6 max-w-lg text-lg leading-relaxed">
          Folio is a reusable Astro template. Tokens live in CSS, structure lives
          in layouts, and pages stay as HTML.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href="#customize">Customize this template</Button>
          <Button href="#features" variant="ghost">See what’s included</Button>
        </div>
      </div>
      <aside
        class="border-line bg-canvas shadow-lift relative overflow-hidden rounded-sm border p-6"
        aria-label="Theme specimen"
      >
        <p class="text-ink-muted text-xs font-semibold tracking-[0.18em] uppercase">
          Specimen
        </p>
        <p class="font-display mt-3 text-3xl">Paper, ink, copper.</p>
        <ul class="mt-6 grid grid-cols-3 gap-3" role="list">
          <li class="space-y-2">
            <span class="bg-canvas border-line block h-14 rounded-sm border"></span>
            <span class="text-ink-muted text-xs">Canvas</span>
          </li>
          <li class="space-y-2">
            <span class="bg-ink block h-14 rounded-sm"></span>
            <span class="text-ink-muted text-xs">Ink</span>
          </li>
          <li class="space-y-2">
            <span class="bg-copper block h-14 rounded-sm"></span>
            <span class="text-ink-muted text-xs">Copper</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <section id="features" class="mx-auto max-w-6xl px-6 py-24">
    <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
      What’s included
    </h2>
    <p class="text-ink-muted mt-3 max-w-xl text-lg">
      Enough structure to start a site. Not so much that you spend a day deleting
      demo pages.
    </p>
    <ol class="mt-12 grid gap-8 md:grid-cols-3">
      {
        features.map((feature, index) => (
          <li class="border-line border-t pt-6">
            <p class="text-copper font-display text-sm">0{index + 1}</p>
            <h3 class="mt-3 text-xl font-semibold">{feature.title}</h3>
            <p class="text-ink-muted mt-2 leading-relaxed">{feature.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="customize" class="bg-canvas-muted border-line border-y">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
        Three files, then it’s yours
      </h2>
      <div class="mt-12 grid gap-10 lg:grid-cols-3">
        {
          steps.map((step) => (
            <article>
              <p class="font-display text-copper text-2xl">{step.n}</p>
              <h3 class="mt-4 text-xl font-semibold">{step.title}</h3>
              <p class="text-ink-muted mt-2 leading-relaxed">{step.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
