---
import { SITE } from "../consts";

const year = new Date().getFullYear();
---

<footer class="border-line mt-24 border-t">
  <div
    class="text-ink-muted mx-auto flex max-w-6xl flex-col gap-3 px-6 py-10 text-sm sm:flex-row sm:items-center sm:justify-between"
  >
    <p>
      © {year} The Everglades Foundation. {SITE.title} is for staff use.
    </p>
    <p>Decks are processed in memory and deleted after download.</p>
  </div>
</footer>
