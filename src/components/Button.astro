---
interface Props {
  href?: string;
  variant?: "primary" | "ghost";
  class?: string;
  disabled?: boolean;
  type?: "button" | "submit";
}

const {
  href,
  variant = "primary",
  class: className,
  disabled = false,
  type = "button",
} = Astro.props;

const styles = {
  primary:
    "bg-accent text-canvas hover:bg-accent-dark active:scale-[0.98] shadow-lift",
  ghost:
    "border border-line bg-transparent text-ink hover:border-accent hover:text-accent active:scale-[0.98]",
};

const classes = [
  "inline-flex min-h-11 items-center justify-center rounded-sm px-5 py-2.5 text-[15px] font-bold tracking-normal transition duration-200 ease-out motion-reduce:transition-none motion-reduce:active:scale-100",
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
  disabled ? "cursor-not-allowed opacity-50 pointer-events-none" : "",
  styles[variant],
  className,
]
  .filter(Boolean)
  .join(" ");
---

{
  href && !disabled ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled}>
      <slot />
    </button>
  )
}
